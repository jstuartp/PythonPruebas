    def filtro_paso_alto(self,data, cutoff, fs, order=4):
        """
        Aplica un filtro paso alto para eliminar la desviación de la línea base (drift)
        que ocurre naturalmente al integrar señales sísmicas.
        """
        nyq = 0.5 * fs
        normal_cutoff = cutoff / nyq
        b, a = butter(order, normal_cutoff, btype='high', analog=False)
        # filtfilt aplica el filtro hacia adelante y hacia atrás para no desfasar la onda
        y = filtfilt(b, a, data)
        return y

    def filtro_pasa_banda(self, data, fs, freq_min=0.05, freq_max=25.0, corners=2, taper_percent=0.05):
        """
        Aplica un taper de tipo Hann en los extremos de la señal y luego un
        filtro pasa banda para aislar las frecuencias sísmicas de interés.
        """
        npts = len(data)

        # 1. Aplicar el Taper (Hann)
        # Calculamos la cantidad de puntos que representan el porcentaje deseado (ej. 5%)
        taper_length = int(npts * taper_percent)

        if taper_length > 0:
            # Se genera una ventana de Hann del doble del tamaño del borde
            window = np.hanning(2 * taper_length)
            taper_array = np.ones(npts)

            # Atenuación suave al inicio (mitad ascendente de la ventana)
            taper_array[:taper_length] = window[:taper_length]
            # Atenuación suave al final (mitad descendente de la ventana)
            taper_array[-taper_length:] = window[-taper_length:]

            # Aplicamos el taper a los datos originales
            data = data * taper_array

        # 2. Aplicar el Filtro Pasa Banda
        nyq = 0.5 * fs
        low = freq_min / nyq
        high = freq_max / nyq

        # Diseño del filtro Butterworth
        b, a = butter(corners, [low, high], btype='bandpass', analog=False)

        # filtfilt aplica el filtro hacia adelante y hacia atrás (fase cero)
        y = filtfilt(b, a, data)

        return y

    """
    Funion para calcular PGV, recibe un trace y calcula la integral completa
    utiliza el filtro paso alto, devuelve x100 para usar cm/s2.
    """
    def calculate_pgv(self,tr):
        dt = 1.0 / 200
        # B. Integrar para obtener Velocidad
        vel_raw = cumulative_trapezoid(tr, dx=dt, initial=0.0)
        vel_clean = vel_raw - np.mean(vel_raw)
        #vel_clean = self.filtro_paso_alto(vel_clean, cutoff=0.05, fs=200)
        vel_clean = self.filtro_pasa_banda(vel_clean,fs=200)
        pgv = np.max(np.abs(vel_clean))
        return pgv * 100

    """
    Funion para calcular PGD, recibe un trace y calcula la integral completa
    integra dos veces para usar la acc y devolver desplazamiento en un mismo proceso
    utiliza el filtro paso alto, devuelve x100 para usar cm/s2.
    """
    def calculate_pgd(self,tr):
        dt = 1.0 / 200
        # B. Integrar de nuevo para obtener Desplazamiento
        vel_raw = cumulative_trapezoid(tr, dx=dt, initial=0.0)
        vel_clean = vel_raw - np.mean(vel_raw)
        #vel_clean = self.filtro_paso_alto(vel_clean, cutoff=0.05, fs=200)
        vel_clean = self.filtro_pasa_banda(vel_clean, fs=200)
        disp_raw = cumulative_trapezoid(vel_clean, dx=dt, initial=0.0)
        disp_clean = disp_raw - np.mean(disp_raw)
        #disp_clean = self.filtro_paso_alto(disp_clean, cutoff=0.05, fs=200)
        disp_clean = self.filtro_pasa_banda(disp_clean, fs=200)
        pgd = np.max(np.abs(disp_clean))
        return pgd * 100

    def calculate_pga(self,tr, inventory, network, station, location, channel):
