    #funcion para cortar los streams y guardarlos en .mseed
    #guarda 3 minutos antes y 3 mins despues del evento
    def cortaWaves(self,streams,evento,t0):

        # 1. Definición de rutas (usando os.path.join para evitar errores con los slashes)
        ruta = os.path.join(OUTPUT_DIR, evento) #directorio SDS donde se guardan mseeds
        rutaJson = os.path.join(OUTPUT_JSON, evento) #directorio donde se guardan JSONS
        rutaRaw = os.path.join(ruta, "raw")

        localizaciones_permitidas = ["00", "", "01", "11", "12", "13"]
        canales_permitidos = ["HNN", "HNZ", "HNE"]

        # 2. Vaciado y creación de directorios
        # Limpiar y recrear directorio de mseed (incluyendo su subcarpeta 'raw')
        if os.path.exists(ruta):
            shutil.rmtree(ruta)
        os.makedirs(rutaRaw, exist_ok=True)  # Crea 'ruta' y 'ruta/raw' de una sola vez

        # Limpiar y recrear directorio de JSONs
        if os.path.exists(rutaJson):
            shutil.rmtree(rutaJson)
        os.makedirs(rutaJson, exist_ok=True)

        # 3. Procesamiento de los streams
        for idx, res in enumerate(streams, 1):

            # Convertimos a string ISO 8601 (Ej: "2024-02-27T10:30:00")
            timestamp_str = t0.strftime('%Y%m%dT%H%M%S')

            payload = {
                "meta": {
                    "station": res["station"],
                    "network": res["network"],
                    "start_time": timestamp_str,
                    "sample_rate": 200,
                    "npts": 7001
                },
                "data": {}
            }

            # Recortar la traza en la ventana deseada
            tr = res["st"]
            trRaw = res["stRaw"]

            for mytr in tr.copy():
                try:
                    if (mytr.stats.location not in localizaciones_permitidas) or (
                            mytr.stats.channel not in canales_permitidos):
                        tr.remove(mytr)
                        trRaw.remove(mytr)
                except Exception as err:
                    waveslogger.error(f"--FALLO CORTAR-- No se pudo cortar {res['station']}")

            tr.trim(starttime=res["t1"], endtime=res["t2"])

            # Rellenar los vectores de datos
            for traza in tr:
                # Usamos el nombre del canal como clave (ej: "HNZ", "HNE")
                canal = traza.stats.channel
                # IMPORTANTE: .tolist() es necesario porque 'json' no serializa numpy arrays
                payload["data"][canal] = traza.data.tolist()

            # 4. Generar nombres de archivo estandarizados
            base_filename = f"{res['network']}_{res['station']}_{timestamp_str}"

            fname = os.path.join(ruta, f"{base_filename}.mseed")
            rawFile = os.path.join(rutaRaw, f"{base_filename}_RAW.mseed")
            jsonfname = os.path.join(rutaJson, f"{base_filename}.json")

            # 5. Escritura de archivos
            try:
                tr.write(fname, format="mseed")
                trRaw.write(rawFile, format="mseed")

                with open(jsonfname, 'w') as f:
                    # separators=(',', ':') elimina espacios vacíos para reducir peso
                    json.dump(payload, f, separators=(',', ':'))

            except Exception as err:
                waveslogger.error(f"--FALLO EN ESCRITURA-- No data written for station {res['station']} \n")
                waveslogger.error(f"--FALLO EN ESCRITURA-- ErrorMessage {err} \n")



